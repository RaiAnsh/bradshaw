# Resend (https://resend.com) — used by /api/request-estimate to email
# free-estimate form submissions.
RESEND_API_KEY=

# Must be on a domain verified in Resend, e.g.
# "Bradshaw Plumbing <estimates@bradshawplumbing.com>"
ESTIMATE_FROM_EMAIL=

# Optional — defaults to sarthak@bradshawplumbing.com
ESTIMATE_TO_EMAIL=
